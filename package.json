{
  "name": "arcana",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "pnpm db:migrate",
    "dev": "next dev",
    "build": "next build",
    "prestart": "pnpm db:migrate",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.ts",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup.ts",
    "db:restore": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/restore.ts",
    "docker:dev": "docker compose up --build app",
    "docker:check": "docker compose run --rm --build app sh -c \"pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test\"",
    "docker:e2e": "docker compose --profile e2e run --rm --build e2e",
    "docker:prod": "mkdir -p data && docker compose --profile prod up --build -d app-prod",
    "docker:sh": "docker compose run --rm --build app bash"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

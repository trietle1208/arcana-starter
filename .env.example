# Copy to .env.local (app) — and to .env if you want to change the Docker port.
# Host port for Docker (read by compose, not by the app). Port 3000 is often taken.
ARCANA_PORT=3100

# Your time zone, so the journal shows dates as you wrote them (the containers run on UTC otherwise).
# ARCANA_TZ=Asia/Ho_Chi_Minh

# Path of the SQLite file (default shown). The Docker production container keeps it in ./data too.
# ARCANA_DB_PATH=./data/arcana.db
